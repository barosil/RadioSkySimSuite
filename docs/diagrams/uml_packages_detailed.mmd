%% RadioSkySim — pacotes individuais (camadas internas reais, nov/2026)
%%
%% Layout interno REAL de cada pacote (packages/<nome>/src/<nome_import>).
%% Nem todos os pacotes têm todas as camadas hexagonais: viz é flat,
%% radiotelescope não tem infrastructure/, waterfall tem adapters/ no topo.
%% Atualizado: 2026-11-06 — verificado contra o código-fonte.

flowchart TB

    subgraph P_CORE["radioskysims-core (kernel)"]
        direction TB
        CORE_DOM["domain/\n(common, geometry, tracks)"]
        CORE_APP["application/\n(ports + adapters)"]
        CORE_INFRA["infrastructure/\n(db/engine, config, logging,\nmonitor, processing)"]
        CORE_CFG["config/ · db/ · monitor/ · processing/"]
        CORE_BOOT["bootstrap/builders\n(build_database, build_logging)"]
        CORE_APP -->|implementado por| CORE_INFRA
        CORE_BOOT --> CORE_INFRA
        CORE_CFG --> CORE_INFRA
    end

    subgraph P_VIZ["radioskysims-viz (flat, sem camadas)"]
        direction TB
        VIZ_MODS["módulos soltos:\nradiotelescope.py, satellite.py,\nsources.py, io.py, ..."]
    end

    subgraph P_BEAM["radioskysims-beam"]
        direction TB
        BEAM_DOM["domain/\n(Beam, BeamProperties, BeamFactory)"]
        BEAM_APP["application/ports/\n(BeamLoaderPort, BeamEvaluatorPort)"]
        BEAM_INFRA["infrastructure/beams/loaders\n(CSV, Analítico, LIT)"]
        BEAM_APP -->|implementado por| BEAM_INFRA
        BEAM_INFRA --> BEAM_DOM
    end

    subgraph P_SKYMAP["radioskysims-skymap"]
        direction TB
        SKY_DOM["domain/\n(SkyMap, NSide, SkyMapDataset,\nSkyMapFactory)"]
        SKY_APP["application/ports/\n(SkyMapGeneratorPort)\n+ SkyMapManager (fachada)"]
        SKY_INFRA["infrastructure/\n(Healpy, PySM3, HiPS,\nskymap/adapters)"]
        SKY_APP -->|implementado por| SKY_INFRA
        SKY_INFRA --> SKY_DOM
    end

    subgraph P_RT["radioskysims-radiotelescope"]
        direction TB
        RT_DOM["domain/\n(Radiotelescope, Antenna,\nSpectrometerBackend)"]
        RT_APP["application/"]
        RT_BOOT["bootstrap/\n(build_configuration via settings.toml)"]
        RT_BOOT --> RT_APP
        RT_APP --> RT_DOM
    end

    subgraph P_SOURCES["radioskysims-sources"]
        direction TB
        SRC_DOM["domain/\n(Satellite, TLESelector, LocalSources,\nRadioSource, SpectralModel)"]
        SRC_APP["application/\n(ports, services, orchestrators)"]
        SRC_INFRA["infrastructure/\n(db, external, signal)"]
        SRC_CLI["interfaces/cli/sources_cli"]
        SRC_APP -->|implementado por| SRC_INFRA
        SRC_CLI --> SRC_APP
    end

    subgraph P_SIM["radioskysims-simulation"]
        direction TB
        SIM_DOM["domain/\n(Simulation, SimulationResult, TOD)"]
        SIM_APP["application/\n(services: SimOrchestrator,\nSimulationService) + ports"]
        SIM_INFRA["infrastructure/\n(processing, db, io)"]
        SIM_BOOT["bootstrap/composition\n(create_sim_orchestrator)"]
        SIM_APP --> SIM_DOM
        SIM_INFRA -.->|implementado por| SIM_APP
        SIM_BOOT --> SIM_APP
    end

    subgraph P_WATERFALL["radioskysims-waterfall (autônomo)"]
        direction TB
        WF_DOM["domain/\n(WaterfallDataset, máscara,\nbaseline, SED)"]
        WF_APP["application/ports"]
        WF_ADAPT["adapters/ (top-level)"]
        WF_APP --> WF_DOM
        WF_ADAPT --> WF_APP
    end

    subgraph P_GNSS["gnsstools4astro (autônomo)"]
        direction TB
        GNSS_DOM["domain/ (RINEX, broadcast ephemeris)"]
        GNSS_APP["application/services"]
        GNSS_INFRA["infrastructure/"]
        GNSS_CLI["interfaces/ · bootstrap/\n(gnss4astro)"]
        GNSS_CLI --> GNSS_APP
        GNSS_APP --> GNSS_DOM
        GNSS_INFRA -.-> GNSS_DOM
    end

    subgraph P_UMBRELLA["radioskysim (umbrella, raiz)"]
        direction TB
        UMB_ENTRY["interfaces/cli, interfaces/gui"]
        UMB_BOOT["bootstrap/composition, bootstrap/builders\n(delega para pacotes)"]
        UMB_ENTRY --> UMB_BOOT
    end

    %% ---- Dependências inter-pacote (declaradas) ----
    P_BEAM -.-> P_CORE
    P_BEAM -.-> P_VIZ
    P_RT -.-> P_CORE
    P_RT -.-> P_VIZ
    P_SOURCES -.-> P_CORE
    P_SOURCES -.-> P_SKYMAP
    P_SOURCES -.-> P_GNSS
    P_SIM -.-> P_CORE
    P_SIM -.-> P_VIZ
    P_SIM -.-> P_BEAM
    P_SIM -.-> P_SKYMAP
    P_SIM -.-> P_SOURCES
    P_SIM -.-> P_RT
    P_VIZ -.-> P_CORE
    P_VIZ -.-> P_BEAM
    UMB_BOOT -.-> P_SIM
    UMB_BOOT -.-> P_CORE

    %% ---- Violações reais (import não declarado) ----
    P_CORE -.-> P_RT
    P_CORE -.-> P_SKYMAP
    P_CORE -.-> P_VIZ
    P_GNSS -.-> P_VIZ
    P_SOURCES -.-> P_VIZ
