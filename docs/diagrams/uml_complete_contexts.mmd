    %% Relações entre bounded contexts
    Satellite --> Tracks
    Satellite --> Signal
    Tracks --> Geometry
    Satellite -->|SatelliteAssembler| SatelliteAssembled[SatelliteAssembled]
    SatelliteAssembled --> Tracks
    SatelliteAssembled --> Signal
    Simulation --> SatelliteAssembled
    Simulation --> Geometry
    Simulation --> TODSimulator
    TODSimulator --> Beam
    Beam --> BeamParamsDomain
    RadioSources --> SpectralModel
    LocalSources --> SolarFlux
    LocalSources --> LocalSourceTrack
    Radiotelescope --> Antenna
    Radiotelescope --> SpectrometerBackend
    Noise --> SystemTemperature
    Noise --> Efficiency
    RFI --> RFIDetector
    SkyMap --> NSide
    SkyMap --> SkyMapDataset

