  end

  subgraph infra["Infraestrutura standalone"]
    gnss[gnsstools4astro]
  end

  umbrella[radioskysim - umbrella / composition root]

  beam --> core
  beam --> viz
  skymap --> core
  rt --> core
  rt --> viz
  sources --> core
  sources --> skymap
  simulation --> core
  simulation --> viz
  simulation --> beam
  simulation --> skymap
  simulation --> sources
  simulation --> rt
  gnss --> core
  gnss --> skymap
  umbrella --> core & viz & beam & skymap & rt & sources & simulation & waterfall & gnss

