flowchart TB
    subgraph ENTRY["Interfaces / Entrypoints (umbrella)"]
        CLI["interfaces/cli (radioskysims)"]
        GUI["interfaces/gui (TODPanel, skymap)"]
        NBAPI["interfaces/notebook_api (fachada de notebook,\nNÃO é REST/FastAPI)"]
        SCRIPTS["scripts/ (start_service, check_db)"]
    end

    subgraph BOOT["Bootstrap (Composition Root)"]
        COMP["bootstrap/composition\n(delega para radioskysims_simulation)"]
        BUILD["bootstrap/builders\n(re-exporta builders de cada pacote)"]
    end

    subgraph PKGS["Pacotes uv workspace (packages/*)"]
        direction TB
        CORE["radioskysims-core\n(kernel: config, db, logging, geometry comum)"]
        VIZ["radioskysims-viz\n(PanelApplication, VisualizerPort)"]
        BEAM["radioskysims-beam\n(Beam, loaders CSV/Analítico)"]
        SKYMAP["radioskysims-skymap\n(SkyMap, Healpy, PySM3, HiPS)"]
        RT["radioskysims-radiotelescope\n(Antenna, SpectrometerBackend)"]
        SOURCES["radioskysims-sources\n(Satellite, LocalSources, RadioSources)"]
        SIMULATION["radioskysims-simulation\n(SimOrchestrator, TOD, ResourceAwareProcessor)"]
        WATERFALL["radioskysims-waterfall\n(autônomo: máscara, baseline, SED)"]
        GNSS["gnsstools4astro\n(RINEX/broadcast ephemeris)"]
    end

    subgraph DATASTORE["Persistência / Dados"]
        PG[("PostgreSQL (metadados)")]
        FILES[("HDF5/Zarr (data/TOD, data/MAPS)")]
        AUX[("data/aux, data/catalog, data/hips, data/temp")]
    end

    ENTRY --> BOOT
    BOOT --> PKGS

    %% ---- Dependências declaradas (pyproject) e confirmadas ----
    SIMULATION --> BEAM
    SIMULATION --> SKYMAP
    SIMULATION --> SOURCES
    SIMULATION --> RT
    SIMULATION --> CORE
    SIMULATION --> VIZ
    SOURCES --> SKYMAP
    SOURCES --> CORE
    SOURCES --> GNSS
    BEAM --> CORE
    BEAM --> VIZ
    SKYMAP --> CORE
    RT --> CORE
    RT --> VIZ
    VIZ --> CORE
    VIZ --> BEAM

    %% ---- Violações reais (import não declarado) ----
    CORE -.-> RT
    CORE -.-> SKYMAP
    CORE -.-> VIZ
    GNSS -.-> VIZ
    SOURCES -.-> VIZ

    %% ---- Declarada sem uso (possível obsoleta) ----
    SKYMAP -.-> CORE

    CORE --> DATASTORE
    SIMULATION --> FILES
    SKYMAP --> FILES
    AUX -. "leitura/escrita" .- CORE
