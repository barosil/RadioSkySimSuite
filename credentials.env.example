# credentials.env.example
# Copy this file to credentials.env and fill in the values.
# NEVER commit credentials.env to version control (já ignorado no .gitignore).
#
# O arquivo credentials.env é carregado automaticamente pelo
# SpaceTrackClient (via python-dotenv), SEM sobrescrever variáveis já
# exportadas no ambiente.
#
# SpaceTrack API credentials (https://www.space-track.org)
# Preencha as chaves abaixo (ST_USER/ST_PWD). Alias opcional aceito pelo
# client: SPACETRACK_USERNAME / SPACETRACK_PASSWORD.
ST_USER=your_username_here
ST_PWD=your_password_here
#
# ⚠️ NÃO colocar credenciais reais em settings.toml [SPACETRACK] — o arquivo
# é versionado. Deixe ST_USER/ST_PWD vazios lá e preencha este arquivo.
#
# Database connection (PostgreSQL)
# ⚠️ A engine (radioskysims_core.db) NÃO lê DATABASE_URL — ela usa a seção
# `[DB]` do settings.toml (POSTGRES_USER/PASSWORD/HOST/PORT/DB), que é a fonte
# única de config de banco. A linha abaixo é mantida apenas como legado e é
# IGNORADA pela engine; não a use como fonte de verdade.
# DATABASE_URL=postgresql://user:password@localhost:5432/radioskysim
#
# Optional: Logging level
LOG_LEVEL=INFO

CIRADA_USERNAME=your_username_here
CIRADA_PASSWORD=your_password_here
